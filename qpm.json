{
  "$schema": "https://raw.githubusercontent.com/QuestPackageManager/QPM.Package/refs/heads/main/qpm.schema.json",
  "version": "0.4.0",
  "sharedDir": "shared",
  "dependenciesDir": "extern",
  "info": {
    "name": "BSML",
    "id": "bsml",
    "version": "0.5.5",
    "url": "https://github.com/bsq-ports/Quest-BSML",
    "additionalData": {
      "overrideSoName": "libbsml.so",
      "cmake": true
    }
  },
  "workspace": {
    "scripts": {
      "build": [
        "pwsh ./scripts/build.ps1"
      ],
      "clean": [
        "pwsh ./scripts/build.ps1 -clean"
      ],
      "copy": [
        "pwsh ./scripts/copy.ps1"
      ],
      "log": [
        "pwsh ./scripts/log.ps1"
      ]
    },
    "ndk": "^29.0.14206865",
    "qmodIncludeDirs": [
      "./build",
      "./extern/libs"
    ],
    "qmodIncludeFiles": [],
    "qmodOutput": "BSML"
  },
  "dependencies": [
    {
      "id": "libil2cpp",
      "versionRange": "^0.5.0",
      "additionalData": {}
    },
    {
      "id": "beatsaber-hook",
      "versionRange": "^8.0.1",
      "additionalData": {}
    },
    {
      "id": "bs-cordl",
      "versionRange": "^4500.0.0",
      "additionalData": {}
    },
    {
      "id": "custom-types",
      "versionRange": "^0.20.0",
      "additionalData": {}
    },
    {
      "id": "scotland2",
      "versionRange": "^0.1.7",
      "additionalData": {
        "includeQmod": false,
        "private": true
      }
    },
    {
      "id": "paper2_scotland2",
      "versionRange": "^4.8.0",
      "additionalData": {
        "private": true
      }
    },
    {
      "id": "tinyxml2",
      "versionRange": "^10.0.0",
      "additionalData": {}
    },
    {
      "id": "gif-lib",
      "versionRange": "^5.2.2",
      "additionalData": {
        "private": true
      }
    },
    {
      "id": "flamingo",
      "versionRange": "^1.2.1",
      "additionalData": {}
    }
  ]
}
